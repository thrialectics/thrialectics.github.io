<section>
  <h2>Projects</h2>
  <ul>
    {%- for project in projects %}
    <li>
      <a href="{{ project.url }}">{{ project.name }}</a> — {{ project.tagline }}
    </li>
    {%- endfor %}
  </ul>
</section>

<section>
  <h2>Writing</h2>
  <ul>
    {%- for post in collections.posts | head(5) %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="post-date">({{ post.date | dateFormat }})</span>
    </li>
    {%- else %}
    <li>Coming soon</li>
    {%- endfor %}
  </ul>
</section>
