---
layout: base.njk
---

<header>
  <h1>Marianne <span class="glyph">☉</span></h1>
  <p class="tagline">I build tools that preserve context and connection.</p>
</header>

<div class="social-links">
  <a href="https://github.com/thrialectics">GitHub</a>
  <span>·</span>
  <a href="mailto:thrialectics@gmail.com">Email</a>
  <span>·</span>
  <a href="/feed.xml">RSS</a>
</div>

<nav class="site-nav">
  <a href="/blog/">Writing</a>
  <a href="/about/">About</a>
</nav>

<hr>

<section>
  <h2>Projects</h2>
  <ul>
    {%- for project in projects %}
    <li>
      <a href="{{ project.url }}">{{ project.name }}</a> — {{ project.tagline }}
    </li>
    {%- endfor %}
  </ul>
</section>

<section>
  <h2>Writing</h2>
  <ul>
    {%- for post in collections.posts | head(5) %}
    <li>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="post-date">({{ post.date | dateFormat }})</span>
    </li>
    {%- else %}
    <li>Coming soon</li>
    {%- endfor %}
  </ul>
</section>
